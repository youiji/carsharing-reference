# Скопируйте в backend/.env и подставьте свои значения.
# Переменные окружения имеют приоритет над этим файлом.

# Адрес HTTP-сервера
HTTP_ADDR=:8080

# Подключение к PostgreSQL
DATABASE_URL=postgres://carsharing:carsharing@localhost:5432/carsharing?sslmode=disable

# Секрет подписи JWT (HS256), не короче 32 символов.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Срок жизни токена
JWT_TTL=30m
